<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/blanco">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comparativa de librerias"
        android:textColor="@color/verde_oscuro"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnVolley"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Probar Volley"
        android:backgroundTint="@color/verde"
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/txtVolley"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sin probar"
        android:textColor="@color/negro" />

    <Button
        android:id="@+id/btnOkHttp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Probar OkHttp"
        android:backgroundTint="@color/amarillo"
        android:textColor="@color/negro" />

    <TextView
        android:id="@+id/txtOkHttp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sin probar"
        android:textColor="@color/negro" />

    <Button
        android:id="@+id/btnRetrofit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Probar Retrofit"
        android:backgroundTint="@color/verde_oscuro"
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/txtRetrofit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sin probar"
        android:textColor="@color/negro" />

</LinearLayout>
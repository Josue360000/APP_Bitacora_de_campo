<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blanco">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        android:padding="14dp"
        android:text="Laboratorio: Volley vs OkHttp vs Retrofit"
        android:textColor="@color/blanco"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL base de la API"
                android:textColor="@color/negro"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Endpoint"
                android:textColor="@color/negro"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/grupoEndpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/rbNormal">

                <RadioButton
                    android:id="@+id/rbNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GET api/registros" />

                <RadioButton
                    android:id="@+id/rbLento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GET api/pruebas/lento (timeout)" />

                <RadioButton
                    android:id="@+id/rbError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GET api/pruebas/error (500)" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Token"
                android:textColor="@color/negro"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/grupoToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/rbTokenValido"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbTokenValido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Válido" />

                <RadioButton
                    android:id="@+id/rbTokenInvalido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inválido" />

                <RadioButton
                    android:id="@+id/rbSinToken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin token" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVolley"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/verde"
                    android:text="Volley"
                    android:textColor="@color/blanco" />

                <Button
                    android:id="@+id/btnOkHttp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="@color/verde"
                    android:text="OkHttp"
                    android:textColor="@color/blanco" />

                <Button
                    android:id="@+id/btnRetrofit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/verde"
                    android:text="Retrofit"
                    android:textColor="@color/blanco" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressComparativa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/verde"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/gris"
                android:minHeight="90dp"
                android:padding="12dp"
                android:text="Elige una librería"
                android:textColor="@color/negro"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Historial"
                    android:textColor="@color/negro"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLimpiar"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limpiar" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/negro"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
